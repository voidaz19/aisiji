{
  "$description": "爱思记当前已落地的跨端设计令牌。平台专属深色值不被合并为虚假的单一值，详见 platform-mapping.md。",
  "color": {
    "light": {
      "ink": { "$type": "color", "$value": "#2D332E" },
      "ink-muted": { "$type": "color", "$value": "#687163" },
      "paper": { "$type": "color", "$value": "#FFFFFF" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "surface-muted": { "$type": "color", "$value": "#F7F7F5" },
      "leaf": { "$type": "color", "$value": "#4F7D68" },
      "leaf-soft": { "$type": "color", "$value": "#DCE9DD" },
      "gold": { "$type": "color", "$value": "#D2A448" },
      "gold-soft": { "$type": "color", "$value": "#F5E8C1" },
      "clay": { "$type": "color", "$value": "#D77A61" }
    },
    "dark": {
      "android": {
        "ink": { "$type": "color", "$value": "#F5EFE2" },
        "paper": { "$type": "color", "$value": "#151712" },
        "surface": { "$type": "color", "$value": "#20231D" },
        "surface-muted": { "$type": "color", "$value": "#2B2F27" },
        "primary": { "$type": "color", "$value": "#AAD7BE" },
        "primary-container": { "$type": "color", "$value": "#284837" },
        "secondary": { "$type": "color", "$value": "#D2A448" },
        "secondary-container": { "$type": "color", "$value": "#4A3F24" },
        "tertiary": { "$type": "color", "$value": "#B6D2AE" },
        "tertiary-container": { "$type": "color", "$value": "#263527" },
        "error": { "$type": "color", "$value": "#FFB4A5" }
      },
      "web": {
        "ink": { "$type": "color", "$value": "#EDF3EC" },
        "ink-muted": { "$type": "color", "$value": "#A5B1A6" },
        "paper": { "$type": "color", "$value": "#111611" },
        "surface": { "$type": "color", "$value": "#1A211A" },
        "surface-muted": { "$type": "color", "$value": "#222A22" },
        "leaf": { "$type": "color", "$value": "#7DBB96" },
        "gold": { "$type": "color", "$value": "#E1BD65" },
        "clay": { "$type": "color", "$value": "#E17F6C" }
      },
      "android-editor": {
        "ink": { "$type": "color", "$value": "#EDF3EC" },
        "ink-muted": { "$type": "color", "$value": "#AEB9AD" },
        "paper": { "$type": "color", "$value": "#171A18" },
        "leaf": { "$type": "color", "$value": "#90CFA7" }
      }
    },
    "state": {
      "selected-light": { "$type": "color", "$value": "rgba(79, 125, 104, 0.14)" },
      "selection-light": { "$type": "color", "$value": "rgba(79, 125, 104, 0.22)" },
      "selection-dark": { "$type": "color", "$value": "rgba(144, 207, 167, 0.28)" },
      "danger-text-light": { "$type": "color", "$value": "#9B4E45" }
    }
  },
  "typography": {
    "family": {
      "brand": {
        "$type": "fontFamily",
        "$value": ["LXGW WenKai", "霞鹜文楷", "STKaiti", "KaiTi", "Kaiti SC", "Microsoft YaHei", "sans-serif"]
      },
      "code": {
        "$type": "fontFamily",
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
      }
    },
    "editor": {
      "body-size": { "$type": "dimension", "$value": "16px" },
      "line-height": { "$type": "number", "$value": 1.72 },
      "heading-1-size": { "$type": "dimension", "$value": "28px" },
      "heading-2-size": { "$type": "dimension", "$value": "24px" },
      "heading-3-size": { "$type": "dimension", "$value": "20px" }
    }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "8px" },
    "sm": { "$type": "dimension", "$value": "12px" },
    "md": { "$type": "dimension", "$value": "18px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "30px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "soft": {
      "sm": { "$type": "shadow", "$value": "0 8px 28px rgba(0, 0, 0, 0.06)" },
      "md": { "$type": "shadow", "$value": "0 14px 44px rgba(0, 0, 0, 0.08)" },
      "lg": { "$type": "shadow", "$value": "0 18px 62px rgba(0, 0, 0, 0.09)" },
      "dark-sm": { "$type": "shadow", "$value": "0 8px 28px rgba(0, 0, 0, 0.28)" },
      "dark-md": { "$type": "shadow", "$value": "0 14px 44px rgba(0, 0, 0, 0.34)" },
      "dark-lg": { "$type": "shadow", "$value": "0 18px 62px rgba(0, 0, 0, 0.42)" }
    }
  },
  "motion": {
    "quick": { "$type": "duration", "$value": "150ms" },
    "medium": { "$type": "duration", "$value": "220ms" },
    "easing-standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
    "popover-enter": { "$type": "duration", "$value": "140ms" },
    "popover-exit": { "$type": "duration", "$value": "40ms" }
  },
  "layout": {
    "desktop-rail-width": { "$type": "dimension", "$value": "46px" },
    "desktop-sidebar-width": { "$type": "dimension", "$value": "312px" },
    "desktop-titlebar-height": { "$type": "dimension", "$value": "44px" },
    "editor-content-max-width": { "$type": "dimension", "$value": "860px" },
    "interactive-min-size": { "$type": "dimension", "$value": "44px" }
  }
}
